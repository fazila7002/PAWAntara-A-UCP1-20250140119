<%- include('partials/head', { title: 'Tanya AI' }) %>
<%- include('partials/navbar', { active: 'tanya-ai' }) %>

<main>

  <section class="section" aria-labelledby="judul-chat">
    <h1 id="judul-chat" class="section-judul">Tanya AI</h1>
    <p class="section-subjudul">
      Tanyakan jam buka, ongkir, cara pembayaran, atau ketersediaan stok tanpa
      menunggu balasan WhatsApp.
    </p>

    <div class="chat-wrapper">

      <article class="chat-panel" aria-label="Percakapan dengan asisten toko">
        <header class="chat-header">
          <span class="chat-avatar">
            <%- include('partials/ikon', { nama: 'chat' }) %>
          </span>
          <div>
            <strong>Asisten Toko Ariesta</strong>
            <small>Biasanya membalas dalam beberapa detik</small>
          </div>
        </header>

        <!-- aria-live agar balasan baru ikut dibacakan pembaca layar -->
        <div class="chat-body" id="daftarPesan" aria-live="polite">
          <div class="bubble bubble-ai">
            <p>
              Halo! Saya asisten Toko Sembako Ariesta. Ada yang bisa saya bantu
              soal harga, stok, jam buka, ongkir, atau cara pembayaran?
            </p>
          </div>
        </div>

        <!-- form chat: label terhubung ke input demi aksesibilitas.
             Dikirim lewat Fetch API ke POST /api/chat, bukan form action biasa. -->
        <form class="chat-form" id="formChat" novalidate>
          <label for="pertanyaan" class="label-visually-hidden">
            Tulis pertanyaan untuk asisten toko
          </label>
          <input
            type="text"
            id="pertanyaan"
            name="pertanyaan"
            placeholder="Tulis pertanyaanmu di sini..."
            autocomplete="off"
            aria-describedby="catatan-chat">
          <button type="submit" id="tombolKirim" class="tombol tombol-utama">Kirim</button>
        </form>

        <p id="catatan-chat" class="chat-catatan">
          Balasan diproses di server lewat <code>POST /api/chat</code> memakai
          logika kata kunci buatan sendiri &mdash; tanpa API AI pihak ketiga.
        </p>
      </article>

      <aside class="chat-samping" aria-labelledby="judul-contoh">
        <h2 id="judul-contoh">Contoh Pertanyaan</h2>
        <p class="chat-samping-catatan">Klik untuk langsung mengirim.</p>
        <ul class="daftar-contoh">
          <li><button type="button" class="contoh-tanya">Toko buka jam berapa?</button></li>
          <li><button type="button" class="contoh-tanya">Ada ongkir ke daerah Kasihan?</button></li>
          <li><button type="button" class="contoh-tanya">Bisa bayar pakai QRIS?</button></li>
          <li><button type="button" class="contoh-tanya">Beras stoknya masih ada?</button></li>
          <li><button type="button" class="contoh-tanya">Harga minyak goreng berapa?</button></li>
        </ul>

        <h2>Butuh cepat?</h2>
        <p>Hubungi WhatsApp pada jam operasional toko.</p>
        <p class="chat-kontak">0812-3456-7890</p>
      </aside>

    </div>
  </section>

</main>

<%- include('partials/footer', { scriptHalaman: '/js/chat.js' }) %>
