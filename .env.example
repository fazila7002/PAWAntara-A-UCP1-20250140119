# Salin file ini menjadi .env lalu sesuaikan isinya.
# File .env asli sengaja tidak ikut di-commit (lihat .gitignore).
#
# Catatan: aplikasi tetap bisa dijalankan tanpa file .env karena semua nilai
# di bawah punya default di kode. File ini dipakai supaya secret sesi tidak
# ikut tersimpan di dalam repository.

SESSION_SECRET=ganti-dengan-teks-acak-yang-panjang
PORT=3000

# Akun admin/kasir yang di-seed saat server dinyalakan.
# Kalau dikosongkan, dipakai default admin / admin123 (lihat README).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
