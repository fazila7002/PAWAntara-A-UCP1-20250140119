<%- include('partials/head', { title: 'Beranda' }) %>
<%- include('partials/navbar', { active: 'beranda' }) %>

<main>

  <!-- HERO -->
  <section class="hero" aria-labelledby="judul-hero">
    <div class="hero-teks">
      <p class="hero-label">UMKM Sembako &amp; Kebutuhan Rumah Tangga</p>
      <h1 id="judul-hero">Belanja sembako tanpa harus tanya harga lewat WhatsApp.</h1>
      <p class="hero-deskripsi">
        Stok dan harga di Toko Sembako Ariesta selalu diperbarui langsung oleh Ibu Aries.
        Cek dulu di sini sebelum belanja, atau tanya apa saja lewat fitur Tanya AI.
      </p>
      <div class="hero-tombol">
        <a href="/produk" class="tombol tombol-utama">Lihat Daftar Produk</a>
        <a href="/tanya-ai" class="tombol tombol-garis">Tanya AI</a>
      </div>
    </div>

    <aside class="hero-kartu" aria-label="Informasi singkat toko">
      <h2>Kenapa belanja di sini?</h2>
      <ul>
        <li>
          <%- include('partials/ikon', { nama: 'kartu', kelas: 'ikon-kecil' }) %>
          <span><strong>Harga selalu update</strong> dikelola sendiri oleh pemilik toko.</span>
        </li>
        <li>
          <%- include('partials/ikon', { nama: 'kotak', kelas: 'ikon-kecil' }) %>
          <span><strong>Stok transparan</strong> ketahuan habis atau tidak sebelum datang.</span>
        </li>
        <li>
          <%- include('partials/ikon', { nama: 'truk', kelas: 'ikon-kecil' }) %>
          <span><strong>Bisa diantar</strong> gratis ongkir area Bantul kota.</span>
        </li>
        <li>
          <%- include('partials/ikon', { nama: 'jam', kelas: 'ikon-kecil' }) %>
          <span><strong>Buka tiap hari</strong> 07.00 sampai 20.00 WIB.</span>
        </li>
      </ul>
    </aside>
  </section>

  <!-- KATEGORI -->
  <section class="section" aria-labelledby="judul-kategori">
    <h2 id="judul-kategori" class="section-judul">Kategori Belanja</h2>
    <p class="section-subjudul">Pilih kategori untuk langsung menyaring daftar produk.</p>

    <div class="grid-kategori">
      <a href="/produk?kategori=Beras" class="kartu-kategori">
        <span class="kategori-ikon">
          <%- include('partials/ikon', { kategori: 'Beras', kelas: 'ikon-sedang' }) %>
        </span>
        <h3>Beras</h3>
        <p>Beras premium sampai medium</p>
      </a>
      <a href="/produk?kategori=Minyak" class="kartu-kategori">
        <span class="kategori-ikon">
          <%- include('partials/ikon', { kategori: 'Minyak', kelas: 'ikon-sedang' }) %>
        </span>
        <h3>Minyak</h3>
        <p>Minyak goreng kemasan &amp; curah</p>
      </a>
      <a href="/produk?kategori=Gula" class="kartu-kategori">
        <span class="kategori-ikon">
          <%- include('partials/ikon', { kategori: 'Gula', kelas: 'ikon-sedang' }) %>
        </span>
        <h3>Gula</h3>
        <p>Gula pasir dan gula merah</p>
      </a>
      <a href="/produk?kategori=Telur" class="kartu-kategori">
        <span class="kategori-ikon">
          <%- include('partials/ikon', { kategori: 'Telur', kelas: 'ikon-sedang' }) %>
        </span>
        <h3>Telur</h3>
        <p>Telur ayam negeri per kilogram</p>
      </a>
    </div>
  </section>

  <!-- PREVIEW PRODUK -->
  <section class="section" aria-labelledby="judul-unggulan">
    <h2 id="judul-unggulan" class="section-judul">Paling Sering Dibeli</h2>
    <p class="section-subjudul">Tiga produk yang stoknya paling cepat berputar minggu ini.</p>

    <div class="grid-produk">
      <% produkUnggulan.forEach(function (item) { %>
        <article class="kartu-produk">
          <div class="produk-gambar">
            <%- include('partials/ikon', { kategori: item.category, kelas: 'ikon-besar' }) %>
          </div>
          <div class="produk-isi">
            <span class="label-kategori"><%= item.category %></span>
            <h3 class="produk-nama"><%= item.name %></h3>
            <p class="produk-harga">
              Rp <%= item.price.toLocaleString('id-ID') %>
              <span class="produk-satuan">/ <%= item.unit %></span>
            </p>
            <a href="/produk/<%= item.id %>" class="tombol tombol-garis tombol-kecil">Lihat Detail</a>
          </div>
        </article>
      <% }); %>
    </div>

    <p class="tautan-selengkapnya">
      <a href="/produk">
        Lihat semua produk
        <%- include('partials/ikon', { nama: 'panah', kelas: 'ikon-kecil' }) %>
      </a>
    </p>
  </section>

</main>

<%- include('partials/footer') %>
